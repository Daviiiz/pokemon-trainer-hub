---
import Layout from "../layouts/Layout.astro";
import PokemonSearch from "../components/PokemonSearch.jsx";
---

<Layout title="Pokédex">
  <section class="pokedex-page">
    <header class="pokedex-hero">
      <div class="pokedex-hero__content">
        <p class="pokedex-hero__eyebrow">
          Pokédex Nacional
        </p>

        <h1 class="pokedex-hero__title">
          Encuentra tu próximo
          <span>Pokémon.</span>
        </h1>

        <p class="pokedex-hero__description">
          Explora los 1351 Pokémon disponibles, consulta sus
          características y accede a sus estrategias competitivas.
        </p>

        <div class="pokedex-hero__meta">
          <div class="pokedex-meta">
            <strong>1351</strong>
            <span>Pokémon</span>
          </div>

          <div class="pokedex-meta">
            <strong>PokéAPI</strong>
            <span>Catálogo base</span>
          </div>

          <div class="pokedex-meta">
            <strong>Instantánea</strong>
            <span>Búsqueda por nombre</span>
          </div>
        </div>
      </div>

      <div
        class="pokedex-hero__visual"
        aria-hidden="true"
      >
        <div class="pokedex-scanner">
          <div class="pokedex-scanner__ring"></div>

          <span class="pokedex-scanner__number">
            #025
          </span>
        </div>
      </div>
    </header>

    <section class="pokedex-search-panel">
      <PokemonSearch client:load />
    </section>
  </section>
</Layout>

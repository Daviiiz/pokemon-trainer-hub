---
import Layout from "../../layouts/Layout.astro";

type PokemonListado = {
  url: string;
};

type PokemonTipo = {
  type: {
    name: string;
  };
};

type Build = {
  id: number;
  pokemon_id: number;
  titulo: string;
  objeto: string;
  movimiento_1: string;
  movimiento_2: string;
  movimiento_3: string;
  movimiento_4: string;
  rol: string;
  descripcion: string | null;
};

export async function getStaticPaths() {
  const respuesta = await fetch(
    "https://pokeapi.co/api/v2/pokemon?limit=1351"
  );

  const datos = await respuesta.json();

  return datos.results.map((pokemon: PokemonListado) => {
    const partesUrl = pokemon.url.split("/").filter(Boolean);
    const id = partesUrl[partesUrl.length - 1];

    return {
      params: {
        id,
      },
    };
  });
}

const { id } = Astro.params;

const respuestaPokemon = await fetch(
  `https://pokeapi.co/api/v2/pokemon/${id}`
);

const pokemon = await respuestaPokemon.json();

const respuestaBuilds = await fetch(
  `${import.meta.env.PUBLIC_API_URL}/builds?pokemon_id=${id}`
);

const builds: Build[] = await respuestaBuilds.json();

const nombreFormateado =
  pokemon.name.charAt(0).toUpperCase() + pokemon.name.slice(1);

const tipos = pokemon.types.map(
  (tipo: PokemonTipo) => tipo.type.name
);

const imagen =
  pokemon.sprites.other["official-artwork"].front_default;

const alturaMetros = pokemon.height / 10;
const pesoKilos = pokemon.weight / 10;
---

<Layout title={nombreFormateado}>
  <article class="pokemon-detail">
    <section class="pokemon-detail__hero">
      <div class="pokemon-detail__content">
        <a
          class="pokemon-detail__back"
          href="/pokedex"
        >
          ← Volver a Pokédex
        </a>

        <p class="pokemon-detail__eyebrow">
          Pokémon #{pokemon.id}
        </p>

        <h1 class="pokemon-detail__title">
          {nombreFormateado}
        </h1>

        <div class="pokemon-detail__types">
          {tipos.map((tipo: string) => (
            <span
              class={`pokemon-type pokemon-type--${tipo}`}
            >
              {tipo}
            </span>
          ))}
        </div>

        <div class="pokemon-detail__facts">
          <div class="pokemon-fact">
            <span class="pokemon-fact__label">
              Altura
            </span>

            <strong>
              {alturaMetros} m
            </strong>
          </div>

          <div class="pokemon-fact">
            <span class="pokemon-fact__label">
              Peso
            </span>

            <strong>
              {pesoKilos} kg
            </strong>
          </div>

          <div class="pokemon-fact">
            <span class="pokemon-fact__label">
              Pokédex
            </span>

            <strong>
              #{pokemon.id}
            </strong>
          </div>
        </div>
      </div>

      <div class="pokemon-detail__visual">
        <div
          class="pokemon-detail__glow"
          aria-hidden="true"
        ></div>

        <img
          class="pokemon-detail__image"
          src={imagen}
          alt={`Artwork oficial de ${nombreFormateado}`}
          width="380"
          height="380"
        />
      </div>
    </section>

    <section class="pokemon-builds">
      <header class="pokemon-builds__header">
        <div>
          <p class="pokemon-builds__eyebrow">
            Estrategias
          </p>

          <h2>
            Builds destacadas
          </h2>
        </div>

        <span class="pokemon-builds__count">
          {builds.length}
          {builds.length === 1 ? " Build" : " Builds"}
        </span>
      </header>

      {builds.length > 0 ? (
        <div class="pokemon-builds__grid">
          {builds.map((build) => (
            <article class="pokemon-build-card">
              <header class="pokemon-build-card__header">
                <div>
                  <p class="pokemon-build-card__role">
                    {build.rol}
                  </p>

                  <h3>
                    {build.titulo}
                  </h3>
                </div>

                <span class="pokemon-build-card__id">
                  #{build.id}
                </span>
              </header>

              <div class="pokemon-build-card__item">
                <span>Objeto</span>

                <strong>
                  {build.objeto}
                </strong>
              </div>

              <div class="pokemon-build-card__moves">
                <p>
                  Movimientos
                </p>

                <div class="pokemon-move-grid">
                  <span>{build.movimiento_1}</span>
                  <span>{build.movimiento_2}</span>
                  <span>{build.movimiento_3}</span>
                  <span>{build.movimiento_4}</span>
                </div>
              </div>

              {build.descripcion && (
                <p class="pokemon-build-card__description">
                  {build.descripcion}
                </p>
              )}

              <a
                class="pokemon-build-card__link"
                href={`/builds/${build.id}`}
              >
                Ver Build completa
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="pokemon-builds__empty">
          <span aria-hidden="true">
            ◉
          </span>

          <div>
            <strong>
              Sin estrategias todavía
            </strong>

            <p>
              Este Pokémon todavía no tiene Builds destacadas.
            </p>
          </div>
        </div>
      )}
    </section>
  </article>
</Layout>

---
import Layout from "../../layouts/Layout.astro";

type PokemonListado = {
  url: string;
};

type PokemonTipo = {
  type: {
    name: string;
  };
};

type Build = {
  id: number;
  pokemon_id: number;
  titulo: string;
  objeto: string;
  movimiento_1: string;
  movimiento_2: string;
  movimiento_3: string;
  movimiento_4: string;
  rol: string;
  descripcion: string | null;
};

export async function getStaticPaths() {
  const respuesta = await fetch(
    "https://pokeapi.co/api/v2/pokemon?limit=1351"
  );

  const datos = await respuesta.json();

  return datos.results.map((pokemon: PokemonListado) => {
    const partesUrl = pokemon.url.split("/").filter(Boolean);
    const id = partesUrl[partesUrl.length - 1];

    return {
      params: {
        id,
      },
    };
  });
}

const { id } = Astro.params;

const respuestaPokemon = await fetch(
  `https://pokeapi.co/api/v2/pokemon/${id}`
);

const pokemon = await respuestaPokemon.json();

const respuestaBuilds = await fetch(
  `${import.meta.env.PUBLIC_API_URL}/builds?pokemon_id=${id}`
);

const builds: Build[] = await respuestaBuilds.json();

const nombreFormateado =
  pokemon.name.charAt(0).toUpperCase() + pokemon.name.slice(1);

const tipos = pokemon.types.map(
  (tipo: PokemonTipo) => tipo.type.name
);

const imagen =
  pokemon.sprites.other["official-artwork"].front_default;

const alturaMetros = pokemon.height / 10;
const pesoKilos = pokemon.weight / 10;
---

<Layout title={nombreFormateado}>
  <h1>{nombreFormateado}</h1>

  <p>#{pokemon.id}</p>

  <img
    src={imagen}
    alt={`Imagen de ${nombreFormateado}`}
    width="300"
    height="300"
  />

  <p>
    <strong>Tipo:</strong>
    {tipos.join(", ")}
  </p>

  <p>
    <strong>Altura:</strong>
    {alturaMetros} m
  </p>

  <p>
    <strong>Peso:</strong>
    {pesoKilos} kg
  </p>

  <section>
    <h2>Estrategias destacadas</h2>

    {builds.length > 0 ? (
      builds.map((build) => (
        <article>
          <h3>{build.titulo}</h3>

          <p>
            <strong>Rol:</strong>
            {build.rol}
          </p>

          <p>
            <strong>Objeto:</strong>
            {build.objeto}
          </p>

          <h4>Movimientos</h4>

          <ul>
            <li>{build.movimiento_1}</li>
            <li>{build.movimiento_2}</li>
            <li>{build.movimiento_3}</li>
            <li>{build.movimiento_4}</li>
          </ul>

          {build.descripcion && (
            <p>{build.descripcion}</p>
          )}
        </article>
      ))
    ) : (
      <p>Este Pokémon todavía no tiene estrategias destacadas.</p>
    )}
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Inicio">
  <section class="hero">
    <div class="hero__content">
      <p class="hero__eyebrow">
        Explora · Entrena · Compite
      </p>

      <h1 class="hero__title">
        Tu universo Pokémon,
        <span>en un solo lugar.</span>
      </h1>

      <p class="hero__description">
        Explora más de 1300 Pokémon, consulta sus características
        y descubre estrategias competitivas creadas para llevar
        cada combate al siguiente nivel.
      </p>

      <div class="hero__actions">
        <a
          class="hero__button hero__button--primary"
          href="/pokedex"
        >
          Explorar Pokédex
        </a>

        <a
          class="hero__button hero__button--secondary"
          href="/builds"
        >
          Ver Builds
        </a>
      </div>

      <div class="hero__stats">
        <div class="hero-stat">
          <strong>1351</strong>
          <span>Pokémon</span>
        </div>

        <div class="hero-stat">
          <strong>PokéAPI</strong>
          <span>Datos oficiales</span>
        </div>

        <div class="hero-stat">
          <strong>Builds</strong>
          <span>Estrategias propias</span>
        </div>
      </div>
    </div>

    <div
      class="hero__visual"
      aria-hidden="true"
    >
      <div class="hero__orb hero__orb--one"></div>
      <div class="hero__orb hero__orb--two"></div>

      <div class="hero-pokemon-scene">
        <div class="hero-pokemon hero-pokemon--mewtwo">
          <img
            src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/150.png"
            alt=""
          />
        </div>

        <div class="hero-pokemon hero-pokemon--mew">
          <img
            src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/151.png"
            alt=""
          />
        </div>

        <div class="hero-pokemon hero-pokemon--celebi">
          <img
            src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/251.png"
            alt=""
          />
        </div>

        <div class="hero-pokemon hero-pokemon--pikachu">
          <img
            src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10085.png"
            alt=""
          />
        </div>

        <div class="hero-pokemon hero-pokemon--charizard">
          <img
            src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/6.png"
            alt=""
          />
        </div>

        <div class="hero-pokeball hero-pokeball--small">
          <div class="hero-pokeball__center"></div>
        </div>

        <div class="hero-masterball">
          <span class="hero-masterball__letter">M</span>
          <div class="hero-masterball__center"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-features">
    <article class="feature-card feature-card--pokedex">
      <div class="feature-card__header">
        <span class="feature-card__number">
          01
        </span>

        <span class="feature-card__label">
          Catálogo
        </span>
      </div>

      <div
        class="feature-card__symbol"
        aria-hidden="true"
      >
        ◉
      </div>

      <h2>
        Explora la Pokédex
      </h2>

      <p>
        Busca entre más de 1300 Pokémon y consulta información,
        tipos, artwork y características.
      </p>

      <a
        class="feature-card__link"
        href="/pokedex"
      >
        Abrir Pokédex
        <span aria-hidden="true">→</span>
      </a>
    </article>

    <article class="feature-card feature-card--builds">
      <div class="feature-card__header">
        <span class="feature-card__number">
          02
        </span>

        <span class="feature-card__label">
          Estrategia
        </span>
      </div>

      <div
        class="feature-card__symbol"
        aria-hidden="true"
      >
        ⚔
      </div>

      <h2>
        Descubre Builds
      </h2>

      <p>
        Consulta estrategias competitivas con objetos,
        movimientos y roles para distintos Pokémon.
      </p>

      <a
        class="feature-card__link"
        href="/builds"
      >
        Explorar Builds
        <span aria-hidden="true">→</span>
      </a>
    </article>

    <article class="feature-card feature-card--api">
      <div class="feature-card__header">
        <span class="feature-card__number">
          03
        </span>

        <span class="feature-card__label">
          Arquitectura
        </span>
      </div>

      <div
        class="feature-card__symbol"
        aria-hidden="true"
      >
        &lt;/&gt;
      </div>

      <h2>
        Conecta los datos
      </h2>

      <p>
        Cada Pokémon combina información de PokéAPI con
        estrategias almacenadas en nuestra propia API.
      </p>

      <a
        class="feature-card__link"
        href="/pokemon/25"
      >
        Ver un ejemplo
        <span aria-hidden="true">→</span>
      </a>
    </article>
  </section>
</Layout>
